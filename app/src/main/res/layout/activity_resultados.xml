<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/titulo_resultados"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/github_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtTituloResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/github_text_secondary" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardImagen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/github_surface"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/github_border"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/imgNasa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/desc_imagen_nasa"
                android:scaleType="centerCrop" />

            <ProgressBar
                android:id="@+id/progressImagen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/github_accent"
                android:visibility="gone" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/github_surface"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/github_border"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Resultados"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/github_text_primary"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/github_border" />

                <TextView
                    android:id="@+id/txtResultados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/github_text_primary"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAbrirVideo"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_abrir_video"
        android:textAllCaps="false"
        android:textColor="@color/github_accent"
        android:visibility="gone"
        app:strokeColor="@color/github_border" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerarTexto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/btn_generar_texto"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/github_accent"
        app:cornerRadius="6dp" />

</LinearLayout>