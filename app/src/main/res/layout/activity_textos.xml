<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/titulo_textos"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/github_text_primary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="@string/subtitulo_textos"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/github_text_secondary" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/github_surface"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/github_border"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Textos disponibles"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/github_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sin_textos"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/github_text_secondary"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/radioGroupTextos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="@color/github_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/titulo_texto_seleccionado"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/github_text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/github_code_background"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/github_border"
                    app:strokeWidth="1dp">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="320dp">

                        <TextView
                            android:id="@+id/txtTextoSeleccionado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="5dp"
                            android:padding="16dp"
                            android:text="@string/placeholder_texto"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/github_text_primary"
                            android:textIsSelectable="true" />

                    </ScrollView>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerTexto"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_ver_texto"
        android:textAllCaps="false"
        android:textColor="@color/github_accent"
        app:strokeColor="@color/github_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:text="@string/lbl_formato"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/github_text_primary"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFormato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:selectionRequired="true"
        app:singleSelection="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDescargar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/btn_descargar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/github_accent"
            app:cornerRadius="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="@string/btn_eliminar"
            android:textAllCaps="false"
            android:textColor="@color/github_danger"
            app:strokeColor="@color/github_danger" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevaConsulta"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/btn_nueva_consulta"
        android:textAllCaps="false"
        android:textColor="@color/github_accent" />

</LinearLayout>