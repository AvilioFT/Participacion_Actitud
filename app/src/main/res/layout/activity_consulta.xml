<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/titulo_consulta"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/txtApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <!-- ========================= -->
        <!-- USGS -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutUsgs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/ayuda_usgs"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/lbl_fecha_inicio">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtFechaInicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_inicio" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/lbl_fecha_fin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtFechaFin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_fin" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_magnitud">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMagnitud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="@string/texto_magnitud" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= -->
        <!-- NASA -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutNasa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/ayuda_nasa"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_fecha">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtFechaNasa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_nasa" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= -->
        <!-- GEOREF -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutGeoref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/ayuda_georef"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_localidad">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtLocalidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="addressLocality"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= -->
        <!-- TIPO DE CAMBIO S/ $ -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutTc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/ayuda_tc"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/lbl_tc_inicio">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTcInicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_inicio" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/lbl_tc_fin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTcFin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_fin" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/lbl_monto">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMonto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="@string/texto_monto" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/lbl_direccion"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <RadioGroup
                    android:id="@+id/radioGroupDir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rdbSolADol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/dir_sol_a_dol" />

                    <RadioButton
                        android:id="@+id/rdbDolASol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dir_dol_a_sol" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= -->
        <!-- BOTÓN -->
        <!-- ========================= -->

        <Button
            android:id="@+id/btnConsultar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_consultar" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError" />

    </LinearLayout>

</ScrollView>
