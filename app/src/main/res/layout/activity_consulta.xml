<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/titulo_consulta"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/github_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/github_text_secondary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutUsgs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/github_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/github_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ayuda_usgs"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/github_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/lbl_fecha_inicio"
                    android:textColorHint="@color/github_text_secondary"
                    app:boxBackgroundColor="@color/github_surface"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/github_accent"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:hintTextColor="@color/github_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtFechaInicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_inicio"
                        android:textColor="@color/github_text_primary"
                        android:textColorHint="@color/github_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/lbl_fecha_fin"
                    android:textColorHint="@color/github_text_secondary"
                    app:boxBackgroundColor="@color/github_surface"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/github_accent"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:hintTextColor="@color/github_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtFechaFin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_fin"
                        android:textColor="@color/github_text_primary"
                        android:textColorHint="@color/github_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_magnitud"
                    android:textColorHint="@color/github_text_secondary"
                    app:boxBackgroundColor="@color/github_surface"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/github_accent"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:hintTextColor="@color/github_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMagnitud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="@string/texto_magnitud"
                        android:textColor="@color/github_text_primary"
                        android:textColorHint="@color/github_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutNasa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/github_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/github_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ayuda_nasa"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/github_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_fecha"
                    android:textColorHint="@color/github_text_secondary"
                    app:boxBackgroundColor="@color/github_surface"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/github_accent"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:hintTextColor="@color/github_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtFechaNasa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_nasa"
                        android:textColor="@color/github_text_primary"
                        android:textColorHint="@color/github_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutGeoref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/github_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/github_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ayuda_georef"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/github_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_localidad"
                    android:textColorHint="@color/github_text_secondary"
                    app:boxBackgroundColor="@color/github_surface"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/github_accent"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:hintTextColor="@color/github_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtLocalidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="addressLocality"
                        android:inputType="text"
                        android:textColor="@color/github_text_primary"
                        android:textColorHint="@color/github_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutTc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/github_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/github_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ayuda_tc"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/github_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/lbl_tc_inicio"
                    android:textColorHint="@color/github_text_secondary"
                    app:boxBackgroundColor="@color/github_surface"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/github_accent"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:hintTextColor="@color/github_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTcInicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_inicio"
                        android:textColor="@color/github_text_primary"
                        android:textColorHint="@color/github_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/lbl_tc_fin"
                    android:textColorHint="@color/github_text_secondary"
                    app:boxBackgroundColor="@color/github_surface"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/github_accent"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:hintTextColor="@color/github_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTcFin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="date"
                        android:inputType="date"
                        android:text="@string/texto_fecha_fin"
                        android:textColor="@color/github_text_primary"
                        android:textColorHint="@color/github_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/lbl_monto"
                    android:textColorHint="@color/github_text_secondary"
                    app:boxBackgroundColor="@color/github_surface"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/github_accent"
                    app:boxCornerRadiusBottomEnd="6dp"
                    app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp"
                    app:boxCornerRadiusTopStart="6dp"
                    app:hintTextColor="@color/github_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMonto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="@string/texto_monto"
                        android:textColor="@color/github_text_primary"
                        android:textColorHint="@color/github_text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/lbl_direccion"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/github_text_primary" />

                <RadioGroup
                    android:id="@+id/radioGroupDir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rdbSolADol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/github_accent"
                        android:checked="true"
                        android:text="@string/dir_sol_a_dol"
                        android:textColor="@color/github_text_primary" />

                    <RadioButton
                        android:id="@+id/rdbDolASol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/github_accent"
                        android:text="@string/dir_dol_a_sol"
                        android:textColor="@color/github_text_primary" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsultar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/btn_consultar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/github_accent"
            app:cornerRadius="6dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/github_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/github_danger" />

    </LinearLayout>

</ScrollView>